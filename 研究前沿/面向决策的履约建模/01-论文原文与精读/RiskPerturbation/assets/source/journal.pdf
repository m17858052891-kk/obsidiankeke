   <dc:creator>
    <rdf:Seq>
     <rdf:li>Denisa O. Zelinschi</rdf:li>
     <rdf:li>Oriana M. Onicescu</rdf:li>
     <rdf:li>Alexandra Ursache</rdf:li>
     <rdf:li>Eduard Cristian Mihoci</rdf:li>
