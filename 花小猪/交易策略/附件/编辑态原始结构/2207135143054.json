{
  "content": [
    {
      "anchor": "e4001a51-4f63-4bd9-b3d3-4513b52bd75a",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "L_i = P(T=t) = \\Pi_{j=1}^{t-1}(1-h(j))*h(t)"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "67d4f578-7d3f-40b3-be67-568cdd10195c",
      "type": "paragraph"
    },
    {
      "anchor": "5f870b40-0990-4032-bbff-6b2f52ea548b",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "L_i = P(T>t) = S(t)=\\Pi_{j=1}^{t}(1-h(j))"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "0eeb9054-c9a8-444c-b43d-26c103a665c0",
      "type": "paragraph"
    },
    {
      "anchor": "8c7befce-fad6-4f97-887b-ae8eba19c03f",
      "type": "paragraph"
    },
    {
      "anchor": "4b5633af-5b0b-45a5-a64c-603a94710102",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "L_i = [\\Pi_{j=1}^{t_i-1}(1-h(j))]* {h(t_i)}^{\\delta_i}*(1-h(t_i))^{1-\\delta_i}"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "73e1f027-1547-45a1-b2d9-5b1ca2a3fe55",
      "type": "paragraph"
    },
    {
      "anchor": "84fc3edc-1b3b-4cc9-83bd-3b353915aeb5",
      "type": "paragraph"
    },
    {
      "anchor": "1eb4a842-83b2-4069-ab06-6d9fea899b4a",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "log L_i = [\\sum_{j=1}^{t_i-1}log(1-h(j))] + \\delta_i*log  h(t_i) + (1-\\delta_i)*log(1-h(t_i))"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "3ad4767f-c936-41a2-9c9a-b163ee52e3cc",
      "type": "paragraph"
    },
    {
      "anchor": "11f71aec-558d-4295-9262-60e572c752b4",
      "type": "paragraph"
    },
    {
      "anchor": "aeeec45b-10fa-437b-8e67-a83deb38314f",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "log L_i = \\sum_{j=1}^{t_i}[y_{i,j}*log h(j)+(1-y_{i,j})*log(1-h(j))] "
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "23bc17df-79ee-4441-9dfc-6d24f45cbe56",
      "type": "paragraph"
    },
    {
      "anchor": "7fdd0b94-20e8-4d37-9c8c-385d71ab4f64",
      "type": "paragraph"
    },
    {
      "anchor": "684f35c9-4b1b-4688-8791-454209e00fce",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "Loss = -\\sum_{i=1}^{N} log L_i =-\\sum_{i=1}^{N}\\sum_{j=1}^{t_i}[y_{i,j}*log h(j)+(1-y_{i,j})*log(1-h(j))] "
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "53c1b776-ffc3-466e-94f2-197dd31b6a73",
      "type": "paragraph"
    },
    {
      "anchor": "7fae669e-9e0a-4827-82d6-cabb00ff94cb",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "\\min_t \\quad \\frac 1 N \\sum_i^N d_i(t) \n\\\\ s.t. \\quad \\frac 1 N \\sum_i^N F_i(t)- \\={F}(0)\\le C0"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "5fd0082b-514c-43a7-8143-e70b67b2b20e",
      "type": "paragraph"
    },
    {
      "anchor": "8ed793a8-baa0-4dfb-8522-5f84981645b2",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "L(t,\\lambda)=\\frac 1 N \\sum_i^N d_i(t)+\\lambda*[\\frac 1 N \\sum_i^N F_i(t) - \\={F}(0)-C0]"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "b353dca9-2290-488e-8672-b5718ecad0de",
      "type": "paragraph"
    },
    {
      "anchor": "2bec8070-1b4a-47f9-95fc-f75f8e8755a8",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "min \\frac 1 N \\sum_i^N d_i(t)+\\lambda*\\frac 1 N \\sum_i^N F_i(t) "
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "a528d862-b521-425d-9763-927a1add1755",
      "type": "paragraph"
    },
    {
      "anchor": "3f3c1c2e-e6d8-4aaa-926d-c9ae4beb95e2",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "J(t) = d(t)+\\lambda*F(t) \\\\\nt^*=arg \\min_{t \\in \\{0,1,2,...,TMAX\\}} J(t)"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "97fc59e4-2716-46c3-a124-1c71c5d3adba",
      "type": "paragraph"
    },
    {
      "anchor": "fc1a0562-0540-476c-aecf-e18ab869209d",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "\\frac 1 N \\sum_i^N d_i(t)+\\lambda*[\\frac 1 N \\sum_i^N F_i(t)- \\={F}(0)-C0] \\le \\frac 1 N \\sum_i^N d_i(0)+\\lambda*[\\={F}(0) - \\={F}(0)-C0]"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "3c57891d-ef10-4344-84c4-8137a168959d",
      "type": "paragraph"
    },
    {
      "anchor": "b3e604bd-6a03-491b-b952-d48f5a7764c3",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "\\lambda\\le [\\frac 1 N \\sum_i^N d_i(0)-\\frac 1 N \\sum_i^N d_i(t)]/[\\frac 1 N \\sum_i^N F_i(t)- \\={F}(0)] "
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "a80e70bb-57c3-4709-b16d-4dd3585b685a",
      "type": "paragraph"
    },
    {
      "anchor": "f49a2d50-ae1f-4754-bc10-7504579b826e",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "R(t) = [d(0)-d(t)]/[F(t)-F(0)]"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "be02d5c1-4f03-4dba-96c2-23bdf0adae1a",
      "type": "paragraph"
    },
    {
      "anchor": "1a002c18-2ae2-431e-b293-fc3eceff6d81",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "S=\\{t|\\lambda \\le R(t)\\}"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "c4d913c4-eb4c-49ff-a6ad-7f5a7f50467e",
      "type": "paragraph"
    },
    {
      "anchor": "aa7b413d-4b87-46b0-83ba-434e83ff833e",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "t^*=arg \\min_{t \\in \\{1,20\\}}(d(t)+\\lambda F(t))"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "767970a4-9a72-4909-8f6b-14f5e6dd3bb6",
      "type": "paragraph"
    },
    {
      "anchor": "ca395688-8a20-450b-83b3-e79d8e9be3cb",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "J(t) = d(t)+\\lambda*F(t)"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "88e05f6f-25a7-4208-9bbb-cbde5336609f",
      "type": "paragraph"
    },
    {
      "anchor": "1689c7d7-f939-4873-8bab-a9d7cb820670",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "R(i) = [d(t_{i-1})-d(t_i)]/[F(t_i)-F(t_{i-1})]"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "f95b156f-85c0-4ea2-9def-6630a1673995",
      "type": "paragraph"
    },
    {
      "anchor": "188d92df-21c4-4564-9c21-e9225c84436e",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "q(\\lambda) = min_t L(t,\\lambda)\n"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "364bdfcf-179a-4d91-9086-cdd43aaf6fe2",
      "type": "paragraph"
    },
    {
      "anchor": "b7ab3f72-f98e-4944-9357-8332c1a23047",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "t^*(\\lambda)=arg min_t L(t,\\lambda)\n"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "88f5c4fe-47f4-4d43-a281-f2d86cd9cb09",
      "type": "paragraph"
    },
    {
      "anchor": "baae4c37-9050-428d-9d34-ea69ff7b8b61",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "q'(\\lambda) =g(\\lambda)= F'(t^*(\\lambda))-F(0)-C0\n"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
    {
      "anchor": "e83d2803-646b-4ae5-9dc1-873441d20e3a",
      "type": "paragraph"
    },
    {
      "anchor": "df71cb0a-491d-4b97-9204-eb91ecc0b96c",
      "attrs": {
        "level": 1
      },
      "content": [
        {
          "attrs": {
            "latex": "g(\\lambda^*)=0\n"
          },
          "type": "mathquill"
        }
      ],
      "type": "heading"
    },
